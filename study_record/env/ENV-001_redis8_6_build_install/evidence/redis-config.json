{
  "note": "redis.conf 有效配置项（去除注释与空行）与 systemd 单元文件",
  "config_file": "/data/redis/conf/redis.conf",
  "config": [
    "bind 0.0.0.0",
    "port 6379",
    "daemonize no",
    "pidfile /data/redis/redis_6379.pid",
    "logfile /data/redis/logs/redis.log",
    "dir /data/redis/data",
    "requirepass 123456",
    "masterauth 123456",
    "save 3600 1",
    "save 300 100",
    "save 60 10000",
    "rdbcompression yes",
    "dbfilename dump.rdb",
    "appendonly yes",
    "appendfilename \"appendonly.aof\"",
    "appendfsync everysec",
    "auto-aof-rewrite-percentage 100",
    "auto-aof-rewrite-min-size 32mb",
    "maxmemory 1280mb",
    "maxmemory-policy volatile-lru",
    "maxmemory-samples 5",
    "protected-mode no",
    "timeout 0",
    "tcp-keepalive 300",
    "stop-writes-on-bgsave-error yes",
    "rdbchecksum yes",
    "slowlog-log-slower-than 10000",
    "slowlog-max-len 128",
    "rename-command CONFIG \"\"",
    "rename-command FLUSHDB \"\"",
    "rename-command FLUSHALL \"\"",
    "rename-command KEYS \"\""
  ],
  "systemd_unit": "/etc/systemd/system/redis.service",
  "unit_content": [
    "[Unit]",
    "Description=Redis Server",
    "After=network.target",
    "",
    "[Service]",
    "ExecStart=/usr/local/bin/redis-server /data/redis/conf/redis.conf",
    "ExecStop=/usr/local/bin/redis-cli -a 123456 shutdown",
    "Restart=always",
    "User=postgres",
    "Group=postgres",
    "LimitNOFILE=65535",
    "",
    "[Install]",
    "WantedBy=multi-user.target"
  ]
}